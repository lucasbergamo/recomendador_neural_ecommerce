# Reprodutibilidade
SEED=42

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=recommendation-system

# Modelo
EMBEDDING_DIM=64
MLP_LAYERS=[128,64,32]
DROPOUT=0.3
LEARNING_RATE=0.001
BATCH_SIZE=256
MAX_EPOCHS=100
PATIENCE=10

# Avaliação
TOP_K=10

# Dataset (MovieLens 100K por padrão)
DATASET_NAME=ml-100k
